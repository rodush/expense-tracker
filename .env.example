GEMINI_API_KEY=<ENSURE_YOU_HAVE_THIS>
CATEGORIES=Food,Transport,Utilities,Shopping,Other
FALLBACK_CATEGORY=Other
TRANSACTION_DATE_FORMAT=%Y%m%d
# JSON list of literal case-insensitive markers, evaluated in order.
WHO_RULES=[{"contains":"card ending 1234","who":"Alex"}]
WHO_UNMATCHED_LABEL=General
# To run with local SQLite database, use the next DATABASE_URL and comment out the one for PostgreSQL
# DATABASE_URL=sqlite:///./expense-tracker.db
DATABASE_URL=postgresql+psycopg://expense_tracker:local-dev-password@127.0.0.1:5432/expense_tracker
LOG_LEVEL=INFO
LOG_FORMAT=json
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=local-dev-password
# Optional host port for the local PostgreSQL container.
POSTGRES_PORT=5432
# Optional host port for the containerized app.
APP_PORT=8000
